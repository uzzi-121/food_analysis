# CookCast AI Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Google Gemini / Vertex AI Settings
# Enter your Gemini API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=

# TTS Configuration
# Options: 'edge' (built-in high quality neural, no API key needed), 'google' (Google Cloud TTS)
TTS_ENGINE=edge
EDGE_TTS_VOICE=ko-KR-SunHiNeural
# Alternative voices: ko-KR-InJoonNeural, ko-KR-HyunsuNeural

# Google Cloud Settings (Optional if using GCP Cloud TTS & Cloud Storage)
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=
GCS_BUCKET_NAME=
